[Unit]
Description=Label Printer Service
After=network.target

[Service]
Type=simple
User=labelprinter
WorkingDirectory=/opt/label_printer
Environment=DTPWEB_LIB_PATH=/opt/dtpweb_lib
Environment=LABEL_PRINTER_HOST=0.0.0.0
Environment=LABEL_PRINTER_PORT=5001
Environment=FLASK_DEBUG=0
ExecStart=/usr/bin/python3 /opt/label_printer/src/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
