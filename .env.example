# Server port
PORT=18765

# Optional remote bulletin/image synchronization.
# Copy this file to .env and fill in your real values locally.
BULLETIN_USERNAME=your_username
BULLETIN_PASSWORD=your_password
BULLETIN_LOGIN_URL=https://example.com/login
BULLETIN_LIST_URL=https://example.com/bulletins

# Defaults to today's date. Uncomment to fetch a specific day, format YYYY-MM-DD.
# BULLETIN_TARGET_DATE=2026-01-01

# Use false when debugging the browser flow locally.
BULLETIN_HEADLESS=true

# Browser and local output settings.
BULLETIN_BROWSER_CHANNEL=chromium
BULLETIN_OUTPUT_DIR=uploads/device/bulletin
BULLETIN_LATEST_NAME=latest-bulletin.png
BULLETIN_LED_NAME=latest-bulletin-led.png
BULLETIN_DATA_NAME=latest-bulletin-data.json

# Remote page matching options.
BULLETIN_BUTTON_TEXT=公告图片下载
BULLETIN_BOARD_URL_CONTAINS=board-iframe
BULLETIN_BOARD_COLOR=1
BULLETIN_CAPTURE_SCALE=2

# Daily retry rules.
BULLETIN_DAILY_MAX_ATTEMPTS=3
BULLETIN_RETRY_DELAY_MINUTES=60

# Fill these only when automatic selector detection is not enough.
# BULLETIN_LOGIN_USERNAME_SELECTOR=input[name="username"]
# BULLETIN_LOGIN_PASSWORD_SELECTOR=input[type="password"]
# BULLETIN_LOGIN_BUTTON_SELECTOR=button[type="submit"]
